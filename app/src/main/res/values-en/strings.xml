    <string name="onboarding_title">Welcome to LiteSkip</string>
    <string name="ob1_title">1. Enable the accessibility service</string>
    <string name="ob1_body">Tap "Enable" on the home screen, turn on "LiteSkip · Auto Skip Service" in system settings and confirm. This is required for everything.</string>
    <string name="ob2_title">2. Keep it alive</string>
    <string name="ob2_body">On Xiaomi/HyperOS follow the keep-alive steps in the guide: autostart, unrestricted battery, lock the task card, accessibility shortcut.</string>
    <string name="ob3_title">3. Add rules for uncovered popups</string>
    <string name="ob3_body">"My rules → Screen picker" grabs button labels from the target screen; or add rules manually. Built-in rules cover the most common splash ads.</string>
    <string name="ob_done">Done, let\'s go</string>

