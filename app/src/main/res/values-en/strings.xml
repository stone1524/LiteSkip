    <string name="service_label">LiteSkip · Auto Skip Service</string>
    <string name="service_description">LiteSkip uses the accessibility service to watch for "Skip / Agree / Close" buttons on screen and taps them for you, skipping splash ads and popups. It never reads your typed input; the app has no Internet permission and uploads nothing.</string>

